# Generated by install/install-wsl.sh. Sourced by clcd-run and clai-run.
# The Windows host address changes between WSL restarts, so compute it here.
export PATH="$HOME/.local/bin:$HOME/.local/node/bin:$PATH"

CDR_HOST_IP=$(ip route | awk '/^default/ {print $3; exit}')
export CDR_HOST_IP

export HTTPS_PROXY="http://${CDR_HOST_IP}:__RELAY_PORT__"
export HTTP_PROXY="$HTTPS_PROXY"
export NO_PROXY=127.0.0.1,localhost
export no_proxy="$NO_PROXY"
